# Copy to .env (or export these directly) before running the server.
# None of these are required — every feature except the AI assistant
# works with zero configuration. In the installed app the provider, key
# and model are set per business under Admin → AI Settings; these
# variables are only a fallback for local development.

# Which AI backend answers first. Defaults to nvidia (free, no credit card).
# nvidia | groq | openrouter | gemini | openai | claude
# If it fails, the assistant automatically tries every OTHER free provider
# below that has a key. Paid providers (openai, claude) are never used as
# a silent backup — only when chosen here.
AI_PROVIDER=nvidia

# Optional per-provider model pin: set it in Admin → AI Settings (stored
# as ai_<provider>_model). Leave unset to use the built-in model list,
# which skips retired models automatically.

# --- Free providers (no credit card) ---
# NVIDIA NIM — https://build.nvidia.com  (~10,000 requests/day per model)
NVIDIA_API_KEY=
# Groq — https://console.groq.com/keys  (~1,000 requests/day, very fast)
GROQ_API_KEY=
# OpenRouter — https://openrouter.ai/keys  (50 requests/day free; 1,000 after $10 credit)
OPENROUTER_API_KEY=
# Google Gemini — https://aistudio.google.com
GOOGLE_API_KEY=

# NOTE: free tiers may log or train on prompts (Google, Mistral-style
# "free mode", OpenRouter's free providers). Fine for testing; weigh it
# before sending real customer data through them.

# --- Paid ---
OPENAI_API_KEY=
# https://console.anthropic.com
ANTHROPIC_API_KEY=
