{
  "id": "inventory",
  "display_name": "Inventory",
  "fields": [
    {
      "name": "sku",
      "type": "text",
      "required": true,
      "unique": true
    },
    {
      "name": "name",
      "type": "text",
      "required": true
    },
    {
      "name": "category",
      "type": "text",
      "required": false
    },
    {
      "name": "quantity",
      "type": "integer",
      "required": true,
      "default": 0
    },
    {
      "name": "unit",
      "type": "unit",
      "required": false
    },
    {
      "name": "unit_cost",
      "type": "money",
      "required": true,
      "default": 0
    },
    {
      "name": "unit_price",
      "type": "money",
      "required": true,
      "default": 0
    },
    {
      "name": "currency",
      "type": "currency",
      "required": false
    },
    {
      "name": "reorder_level",
      "type": "integer",
      "required": false,
      "default": 5
    },
    {
      "name": "expiry_date",
      "type": "date",
      "required": false
    }
  ],
  "actions": [
    "create",
    "read",
    "update",
    "delete",
    "export",
    "sell",
    "receive",
    "repack",
    "stocktake"
  ],
  "default_roles": {
    "Owner": [
      "create",
      "read",
      "update",
      "delete",
      "export",
      "approve",
      "sell",
      "receive",
      "repack",
      "stocktake"
    ],
    "Manager": [
      "create",
      "read",
      "update",
      "export",
      "sell",
      "receive",
      "repack",
      "stocktake"
    ],
    "Staff": [
      "read",
      "sell"
    ]
  },
  "dashboard_metric": {
    "measure": "quantity",
    "aggregation": "sum",
    "label": "units in stock"
  }
}
