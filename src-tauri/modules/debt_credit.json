{
  "id": "debt_credit",
  "display_name": "Debt & Credit Ledger",
  "fields": [
    {
      "name": "entry_number",
      "type": "text",
      "required": true,
      "unique": true,
      "default": ""
    },
    {
      "name": "party_name",
      "type": "text",
      "required": true
    },
    {
      "name": "direction",
      "type": "text",
      "required": true
    },
    {
      "name": "amount",
      "type": "money",
      "required": true
    },
    {
      "name": "due_date",
      "type": "date",
      "required": false
    },
    {
      "name": "settled",
      "type": "boolean",
      "required": false,
      "default": false
    },
    {
      "name": "payment_method",
      "type": "text",
      "required": false
    },
    {
      "name": "source_order_id",
      "type": "text",
      "required": false
    },
    {
      "name": "notes",
      "type": "text",
      "required": false
    }
  ],
  "actions": [
    "create",
    "read",
    "update",
    "delete",
    "export",
    "settle"
  ],
  "default_roles": {
    "Owner": [
      "create",
      "read",
      "update",
      "delete",
      "export",
      "approve",
      "settle"
    ],
    "Manager": [
      "create",
      "read",
      "update",
      "export",
      "settle"
    ],
    "Staff": [
      "create",
      "read"
    ]
  },
  "dashboard_metric": {
    "measure": "amount",
    "aggregation": "sum",
    "label": "total recorded"
  }
}
