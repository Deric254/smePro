{
  "id": "sales",
  "display_name": "Sales",
  "fields": [
    {
      "name": "item_name",
      "type": "text",
      "required": true
    },
    {
      "name": "customer",
      "type": "text",
      "required": false
    },
    {
      "name": "branch",
      "type": "text",
      "required": false
    },
    {
      "name": "quantity",
      "type": "integer",
      "required": true,
      "default": 1
    },
    {
      "name": "revenue",
      "type": "real",
      "required": true
    },
    {
      "name": "sale_date",
      "type": "date",
      "required": false
    },
    {
      "name": "unit_price",
      "type": "real",
      "required": false
    },
    {
      "name": "payment_method",
      "type": "text",
      "required": false
    },
    {
      "name": "order_id",
      "type": "text",
      "required": false
    }
  ],
  "actions": [
    "create",
    "read",
    "update",
    "delete",
    "export",
    "refund"
  ],
  "default_roles": {
    "Owner": [
      "create",
      "read",
      "update",
      "delete",
      "export",
      "approve",
      "refund"
    ],
    "Manager": [
      "create",
      "read",
      "update",
      "export",
      "refund"
    ],
    "Staff": [
      "create",
      "read"
    ]
  },
  "dashboard_metric": {
    "measure": "revenue",
    "aggregation": "sum",
    "label": "total revenue"
  }
}
