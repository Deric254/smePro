{
  "id": "purchasing",
  "display_name": "Purchasing",
  "fields": [
    {
      "name": "po_number",
      "type": "text",
      "required": true,
      "unique": true,
      "default": ""
    },
    {
      "name": "supplier",
      "type": "text",
      "required": true
    },
    {
      "name": "item_name",
      "type": "text",
      "required": true
    },
    {
      "name": "inventory_record_id",
      "type": "text",
      "required": false
    },
    {
      "name": "quantity",
      "type": "integer",
      "required": true,
      "default": 1
    },
    {
      "name": "unit_cost",
      "type": "money",
      "required": true
    },
    {
      "name": "order_date",
      "type": "date",
      "required": false
    },
    {
      "name": "received",
      "type": "boolean",
      "required": false,
      "default": false
    }
  ],
  "actions": [
    "create",
    "read",
    "update",
    "delete",
    "export"
  ],
  "default_roles": {
    "Owner": [
      "create",
      "read",
      "update",
      "delete",
      "export",
      "approve"
    ],
    "Manager": [
      "create",
      "read",
      "update",
      "export"
    ],
    "Staff": [
      "read"
    ]
  },
  "dashboard_metric": {
    "measure": "quantity",
    "aggregation": "sum",
    "label": "units purchased"
  }
}
